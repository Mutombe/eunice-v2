# Production build env — Vite reads this automatically during `npm run build`
# (matches the NODE_ENV=production mode that the build command sets).
#
# Override per-build with: VITE_API_URL=https://other.host/api npm run build
# Or set as a GitHub Actions secret/variable and pass via the workflow.

# The Render backend URL. Update this once Render assigns the final URL —
# usually https://eunice-backend.onrender.com on the free tier.
VITE_API_URL=https://eunice-backend.onrender.com/api
