# Copy to .env and fill in. .env is gitignored.
SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:4174,http://localhost:4321,http://127.0.0.1:4321

# --- Media storage ------------------------------------------------------
# Local-disk media is the default. To use DigitalOcean Spaces (or any
# S3-compatible storage), set USE_S3_MEDIA=True and provide credentials.
USE_S3_MEDIA=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://sfo3.digitaloceanspaces.com
AWS_S3_REGION_NAME=sfo3

# --- Newsletter / CRM (Mailerlite) --------------------------------------
# Generate from Mailerlite > Integrations > API > Generate new token.
# When prompted for scopes, grant: subscribers (read+write), groups (read).
MAILERLITE_API_KEY=
# Optional: comma-separated group IDs new subscribers are auto-added to.
MAILERLITE_GROUP_IDS=

# --- Unsplash (image curation) ----------------------------------------
# Demo/access key from https://unsplash.com/developers — used by
# scripts/fetch-unsplash.mjs to curate cover images for the site.
UNSPLASH_ACCESS_KEY=

# --- Database ----------------------------------------------------------
# Optional Postgres URL. Leave blank to use local SQLite (db.sqlite3).
# Example Neon URL:
#   postgresql://USER:PASS@HOST/DB?sslmode=require&channel_binding=require
DATABASE_URL=
